# Keyboard shortcuts, loaded by restore.sh with: dconf load / < this file
# @HOME@ is replaced with $HOME at restore time.

[org/gnome/desktop/wm/keybindings]
maximize=@as []
move-to-workspace-down=['<Control><Shift><Alt>Down']
move-to-workspace-left=['<Super><Shift>Page_Up', '<Super><Shift><Alt>Left', '<Control><Shift><Alt>Left']
move-to-workspace-right=['<Super><Shift>Page_Down', '<Super><Shift><Alt>Right', '<Control><Shift><Alt>Right']
move-to-workspace-up=['<Control><Shift><Alt>Up']
switch-to-workspace-1=['<Control>1']
switch-to-workspace-10=['<Control>0']
switch-to-workspace-11=@as []
switch-to-workspace-2=['<Control>2']
switch-to-workspace-3=['<Control>3']
switch-to-workspace-4=['<Control>4']
switch-to-workspace-5=['<Control>5']
switch-to-workspace-6=['<Control>6']
switch-to-workspace-7=['<Control>7']
switch-to-workspace-8=['<Control>8']
switch-to-workspace-9=['<Control>9']
switch-to-workspace-left=['<Shift><Control>Left']
switch-to-workspace-right=['<Shift><Control>Right']
unmaximize=@as []

[org/gnome/mutter/keybindings]
toggle-tiled-left=@as []
toggle-tiled-right=@as []

[org/gnome/shell/keybindings]
screenshot=['<Shift><Control>4']
screenshot-window=['<Control><Alt>5']
show-screenshot-ui=['<Control><Alt>4']

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-window-tiler/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/spotlight-term/']
screensaver=@as []

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-window-tiler]
binding='<Super>t'
command='@HOME@/.local/bin/gnome-window-tiler'
name='Window Tiler'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/spotlight-term]
binding='<Control>space'
command='gnome-terminal'
name='Spotlight Terminal'

[org/gnome/mutter]
dynamic-workspaces=false
